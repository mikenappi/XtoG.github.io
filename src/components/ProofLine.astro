---
interface Props { n: number; formula: string }
const { n, formula } = Astro.props;
---
<div class="line" id={'step-' + n}>
  <span class="number">{n}.</span><div class="statement"><span class="formula">{formula}</span>
    <details><summary aria-label={'Reason for step ' + n}>reason</summary><div class="reason"><slot /></div></details>
  </div>
</div>
<style>
  .line{display:grid;grid-template-columns:2.4ch minmax(0,1fr);gap:.8rem;padding:.6rem 0;align-items:baseline}
  .number{font:500 .8rem system-ui;color:#c2c2c8;text-align:right}
  .formula{font:1.1rem/1.6 'Cambria Math',Georgia,serif;overflow-wrap:anywhere}
  details{margin:0}summary{display:inline-block;cursor:pointer;text-decoration:underline;text-underline-offset:.2em;color:#c2c2c8;font:500 .8rem/1.6 system-ui}
  summary::-webkit-details-marker{display:none}summary:focus-visible{outline:2px solid white;outline-offset:3px}
  .reason{margin:.35rem 0;max-width:36rem;padding:.55rem .8rem;background:#1d1d20;border:1px solid #505056;border-radius:.3rem;font:1rem/1.55 system-ui}
</style>
