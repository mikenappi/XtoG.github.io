---
interface Props { n: number; supplementary?: boolean }
const { n, supplementary = false } = Astro.props;
---
<sup id={(supplementary ? 'supplementary-conclusion-' : 'conclusion-') + n}><span class="sr-only">{supplementary ? 'Supplementary conclusion ' : 'Conclusion '}</span>{supplementary ? 'SC' : 'C'}{n}.</sup>
<style>
  sup { font:600 .65em/0 system-ui,sans-serif; color:#bebec4; vertical-align:super; white-space:nowrap; -webkit-text-stroke:0; }
  .sr-only { position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%); }
</style>
